# ---------- required ----------
# Public HTTPS URL of this server (Vapi + Stripe call it). In dev use a tunnel:
#   cloudflared tunnel --url http://localhost:8000   or   ngrok http 8000
BASE_URL=https://desk.youragency.com
SECRET_KEY=replace-with-64-random-chars        # python -c "import secrets;print(secrets.token_urlsafe(48))"
ADMIN_EMAIL=you@youragency.com
ADMIN_PASSWORD=pick-a-long-password            # only used to create the first admin
SECURE_COOKIES=true                            # false only for plain-http local dev
APP_NAME=Northline AI                          # your brand (editable later in Settings)
# DOMAIN=desk.youragency.com                   # for the optional Caddy HTTPS profile
# POSTGRES_PASSWORD=change-me

# ---------- voice (Vapi) ----------
VAPI_API_KEY=                                  # dashboard.vapi.ai → API keys → private key
VAPI_MODEL_PROVIDER=openai                     # or custom-llm (+ VAPI_CUSTOM_LLM_URL) to run your own model
VAPI_MODEL=gpt-4.1-mini
VAPI_VOICE_PROVIDER=vapi                       # vapi | 11labs | cartesia | …
VAPI_VOICE_ID=Clara
VAPI_TRANSCRIBER_MODEL=nova-3
# VAPI_CUSTOM_LLM_URL=https://your-openai-compatible-endpoint/v1

# ---------- text LLM (agent builder, summaries, chat widget, writing tools) ----------
LLM_BASE_URL=https://api.openai.com/v1         # local: http://host.docker.internal:11434/v1 (Ollama)
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

# ---------- SMS (Twilio) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX                # register A2P 10DLC / toll-free verification first

# ---------- email ----------
EMAIL_PROVIDER=console                         # console | smtp | resend
EMAIL_FROM=Northline AI <hello@youragency.com>
RESEND_API_KEY=
# Replies to outreach: a mailbox your inbound provider forwards to /webhooks/inbound-email/<token> (token shown in Settings)
INBOUND_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---------- billing (Stripe) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=                         # from the webhook endpoint you create for BASE_URL/webhooks/stripe
CURRENCY=usd                                   # cad works too

# ---------- lead finder + crawling ----------
GOOGLE_PLACES_API_KEY=                         # Google Cloud → enable "Places API (New)"
FIRECRAWL_API_KEY=                             # optional; built-in crawler otherwise
CRAWL_MAX_PAGES=12

# ---------- economics ----------
EST_COST_PER_MINUTE_CENTS=15                   # used until Vapi reports the real per-call cost
SCHEDULER_ENABLED=true                         # weekly reports; disable on extra replicas
